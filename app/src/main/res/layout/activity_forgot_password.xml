<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#006769"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardify"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/kelly_slab"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="32dp" />

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="forgot&#10;password"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:fontFamily="@font/kelly_slab"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <!-- Form (hidden after link is sent) -->
        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the email address linked to your account and we'll send you a password reset link."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:layout_marginLeft="31dp"
                android:layout_marginRight="31dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:layout_marginLeft="31dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="31dp"
                android:layout_marginRight="31dp"
                android:background="@drawable/input_field_rounded"
                android:hint="user@example.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="15dp"
                android:layoutDirection="ltr"
                android:gravity="center_vertical"
                android:textAlignment="viewStart" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="31dp"
                android:layout_marginRight="31dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_selector"
                android:text="Send Reset Link"
                android:textColor="#000000"
                android:textAllCaps="false"
                android:fontFamily="@font/ibm_plex_sans_semibold" />

        </LinearLayout>

        <!-- Success state (shown after link is sent) -->
        <LinearLayout
            android:id="@+id/successContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="31dp"
            android:layout_marginRight="31dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textSize="56sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check your inbox"
                android:textColor="#9FE88D"
                android:textSize="22sp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A password reset link has been sent to your email. Click it to set a new password — the link is valid for 30 minutes."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Back to Login -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Login"
            android:textColor="#9FE88D"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
