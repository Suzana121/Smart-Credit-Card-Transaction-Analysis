<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#006769"
        android:paddingVertical="18dp"
        android:paddingHorizontal="20dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">
            <TextView
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="9:41" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:layout_width="66dp"
                android:layout_height="11dp"
                android:src="@android:drawable/star_big_on"
                android:scaleType="fitXY" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Cardify" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="3dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <TextView
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Account" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Picture + Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="50dp"
                android:paddingBottom="24dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivProfilePicture"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_marginBottom="14dp"
                    android:src="@drawable/user"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:textColor="#999494"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Hailey David" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:textColor="#9A9494"
                    android:textSize="15sp"
                    android:layout_marginBottom="2dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="+972 52-212-3123" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:textColor="#9A9494"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="hailey@gmail.com" />

                <LinearLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="250dp"
                    android:layout_height="37dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/rounded_teal_button"
                    android:paddingVertical="11dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_regular"
                        android:text="Edit your profile"
                        android:textColor="#FFFFFF"
                        android:textSize="12dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 1: Friends -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <TextView
                    android:textColor="#006769"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="People you are friends with" />

                <TextView
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Click on the profiles to see shared information" />

                <!--
                    RecyclerView אופקי — מחליף את ה-HorizontalScrollView הסטטי.
                    ה-Adapter (FriendsAdapter) מוסיף אוטומטית כפתור "הוספה" בסוף הרשימה.
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFriends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Section 2: Pending Requests -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:textColor="#006769"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="These people want to be your friends" />

                <TextView
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Click on the profiles to see more details" />

                <!--
                    RecyclerView אופקי — לבקשות ממתינות.
                    ה-Adapter (FriendRequestsAdapter) מציג כפתור "אפשר" מתחת לכל שם.
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFriendRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Logout Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="42dp"
                android:layout_marginStart="48dp"
                android:orientation="horizontal">
                <TextView
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:layout_marginEnd="3dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="do you want to close this account?" />
                <TextView
                    android:id="@+id/tvLogout"
                    android:textColor="#FF0000"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text=" log out" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingBottom="14dp"
        android:elevation="4dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:gravity="end"
            android:layout_marginBottom="4dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="55dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_upload_custom"
                android:layout_marginEnd="18dp"
                android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingHorizontal="9dp"
                android:layout_marginEnd="11dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="12dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <TextView
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Home" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="11dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <TextView
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Shared Info" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="11dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <TextView
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Transactions" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingHorizontal="11dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="12dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <TextView
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Stats" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="17dp"
                    android:src="@android:drawable/star_big_on"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="1dp"
                    android:paddingHorizontal="3dp"
                    android:orientation="vertical">
                    <TextView
                        android:textColor="#006769"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Account" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>